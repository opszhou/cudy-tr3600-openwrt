diff --git a/target/linux/mediatek/dts/mt7981b-fzs-5gcpe-p3.dts b/target/linux/mediatek/dts/mt7981b-fzs-5gcpe-p3.dts
index 52e420b..19e9865 100644
--- a/target/linux/mediatek/dts/mt7981b-fzs-5gcpe-p3.dts
+++ b/target/linux/mediatek/dts/mt7981b-fzs-5gcpe-p3.dts
@@ -279,3 +279,48 @@
 &xhci {
 	status = "okay";
 };
+
+/*
+ * 诊断补丁（0002）：把"可能承载 RK3566 内联链路"的候选口一次性暴露。
+ * 这不是长期形态，只为让机器上一条命令就能看出内联口落在哪：
+ *
+ *   for n in probe0 probe4 probe5 eth1; do
+ *     [ -e /sys/class/net/$n ] || continue
+ *     ip link set "$n" up 2>/dev/null
+ *     echo "$n carrier=$(cat /sys/class/net/$n/carrier) rx=$(cat /sys/class/net/$n/statistics/rx_packets)"
+ *   done
+ *
+ * 判读：carrier=1 或 rx_packets 持续增长的那个，就是 RK3566 的方向；
+ *       之后把本补丁收敛成正式形态（并入 br-lan 或独立网段）。
+ */
+
+/* MT7981 第二路 GMAC（内部 GPHY，0001 里未启用）→ eth1 */
+&eth {
+	gmac1: mac@1 {
+		compatible = "mediatek,eth-mac";
+		reg = <1>;
+		phy-mode = "gmii";
+		phy-handle = <&int_gbe_phy>;
+	};
+};
+
+/* MT7531 未被 0001 描述的端口：p0 / p4（内部 GE PHY）、p5（2.5G，无内部 PHY，常作板间 RGMII） */
+&switch {
+	ports {
+		port@0 {
+			reg = <0>;
+			label = "probe0";
+		};
+
+		port@4 {
+			reg = <4>;
+			label = "probe4";
+		};
+
+		port@5 {
+			reg = <5>;
+			label = "probe5";
+			phy-mode = "rgmii";
+		};
+	};
+};
