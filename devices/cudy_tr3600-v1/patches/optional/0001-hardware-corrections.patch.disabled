Subject: [RFC] mediatek: filogic: correct Cudy TR3600 v1 hardware data

Applies after OpenWrt pull request 24596 head
046aec0dccd90f5a156cb8e9725c121c81955dd3.

This is an experimental local source candidate. It has no Signed-off-by line and
must not be submitted upstream until authorship, provenance and license review
are complete.

---
 target/linux/mediatek/dts/mt7987b-cudy-tr3600-v1.dts | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/target/linux/mediatek/dts/mt7987b-cudy-tr3600-v1.dts b/target/linux/mediatek/dts/mt7987b-cudy-tr3600-v1.dts
index 11eca35..17b1921 100644
--- a/target/linux/mediatek/dts/mt7987b-cudy-tr3600-v1.dts
+++ b/target/linux/mediatek/dts/mt7987b-cudy-tr3600-v1.dts
@@ -3,6 +3,7 @@
 /dts-v1/;
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/leds/common.h>
 
 #include "mt7987b.dtsi"
@@ -54,7 +55,7 @@
 			label = "mode";
 			linux,code = <BTN_0>;
 			linux,input-type = <EV_SW>;
-			gpios = <&pio 0 GPIO_ACTIVE_LOW>;
+			gpios = <&pio 0 GPIO_ACTIVE_HIGH>;
 			debounce-interval = <10>;
 		};
 
@@ -82,6 +83,8 @@
 
 &fan {
 	fan-supply = <&fan_3p3v>;
+	interrupt-parent = <&pio>;
+	interrupts = <5 IRQ_TYPE_EDGE_RISING>;
 	pwms = <&pwm 1 50000 0>;
 	status = "okay";
 };
@@ -104,11 +107,13 @@
 
 &mdio {
 	phy1: phy@1 {
-		compatible = "ethernet-phy-id001c.c849";
+		compatible = "ethernet-phy-ieee802.3-c45";
 		reg = <1>;
+		interrupt-parent = <&pio>;
+		interrupts = <41 IRQ_TYPE_LEVEL_LOW>;
 		reset-gpios = <&pio 42 GPIO_ACTIVE_LOW>;
 		reset-assert-us = <100000>;
-		reset-deassert-us = <120000>;
+		reset-deassert-us = <100000>;
 	};
 
 	phy15: phy@f {
@@ -143,10 +148,9 @@
 			nvmem-cells = <&eeprom_factory_0>;
 			nvmem-cell-names = "eeprom";
 
-			/* Offset 3 keeps the 2.4 GHz MAC distinct from LAN. */
 			band@0 {
 				reg = <0>;
-				nvmem-cells = <&macaddr_bdinfo_de00 3>;
+				nvmem-cells = <&macaddr_bdinfo_de00 0>;
 				nvmem-cell-names = "mac-address";
 			};
 
