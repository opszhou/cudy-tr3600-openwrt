# 设备 .config 种子 —— 只写「目标选择 + 基础偏好」，
# 其余依赖项由 make defconfig 自动补全，避免维护几千行完整配置。

# ---- 目标与机型 ----
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cudy_tr3600-v1=y

# ---- 编译维护 ----
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# ---- 基础体验（中文化 / HTTPS 管理页 / 包管理器）----
# LUCI_LANG：新版 LuCI 的语言开关，必须开启，否则所有 luci-i18n-* 语言包不会被编译
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y

# ---- 无线：wpad 默认换 wpad-mesh-openssl（mesh + WPA3，openssl 加密栈）----
# 注意 wpad 各变体互斥，需显式关掉默认的 mbedtls 变体，否则 defconfig 二选一可能保留错误项
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-mesh-openssl=y
