# 蜂窝模组支持（QModem）—— 随身WiFi / USB 上网卡 / 4G/5G 模组
# UI: LuCI -> 网络 -> QModem（推荐使用纯 JS 的 qmodem-next，勿与旧版 qmodem UI 同装）
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_luci-app-qmodem-next=y
CONFIG_PACKAGE_luci-i18n-qmodem-next-zh-cn=y

# QModem 的 IPv6 ND 工具选择（三选一 choice，默认 ndisc6）：选「都不包含」。
# 原因：qmodem feed 自带的 ndisc6 已损坏——1.0.2 源 remlab.net 返回 410、全网无镜像；
#       升级到 Debian 池 1.0.8 后，src/trace-tcp.c 用 C11 alignas 而该包编译带 -std=c99，
#       直接语法错误（run#17 实测）。rdisc6 是独立包、该 feed 里并不存在，选了也是缺包。
# 恢复方式：修 trace-tcp.c（alignas 改 __attribute__((aligned))）后改回 INCLUDE_ndisc6。
# 符号名注意：QModem 已 pin 到 main 固定 commit（见 upstreams/*/feeds.append）。
#   main 把 choice 从 luci/luci-app-qmodem/Makefile 搬进 application/qmodem/Makefile，
#   前缀随包由 PACKAGE_luci-app-qmodem_ 改为 PACKAGE_qmodem_；
#   不改会让默认的 INCLUDE_ndisc6 生效，拉入编译不过的 ndisc6（run#17 老坑）。
CONFIG_PACKAGE_qmodem_INCLUDE_no_ndisc_rdisc6=y

# USB 驱动：覆盖常见随身WiFi的上网卡协议（RNDIS/QMI/NCM/MBIM/串口）
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_usb-modeswitch=y

# 用户态拨号工具：上面那些 kmod 只提供内核接口（/dev/cdc-wdm*、wwan0），
# 真正协商 PDP 会话的是这两个工具，缺了它们模组能识别但拿不到 IP：
#   umbim —— MBIM 会话，地址由控制通道协商，不依赖 DHCP 和 carrier
#            （实测 RM500U-CNV 只有 MBIM 可用，ECM/NCM 的 carrier 恒 0）
#   uqmi  —— QMI/rmnet 会话，高通系模组走这条路
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_uqmi=y
