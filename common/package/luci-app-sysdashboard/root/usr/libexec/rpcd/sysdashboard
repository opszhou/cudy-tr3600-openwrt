#!/bin/sh
# sysdashboard -- rpcd data provider for luci-app-sysdashboard
#
# Purely read-only. Takes ONE snapshot from /proc, /sys and the DHCP lease file
# and prints a single JSON object. The LuCI view does the delta calculation
# (rates, CPU usage) between two snapshots, so this script never sleeps,
# never keeps state and never writes anything.
#
# rpcd protocol:
#   <script> list       -> {"get":{}}
#   <script> call get   -> snapshot JSON (params on stdin are ignored)
#
# All paths can be overridden for the sandbox test in
# scripts/test-sysdashboard.sh:
#   SYSDASH_PROC_DIR / SYSDASH_SYS_DIR / SYSDASH_LEASES_FILE
#
# Deliberately NOT using "set -e": every source may be absent on a given
# device (no fan, no thermal zone, no conntrack, no leases). A failed read
# must degrade to -1 / empty array, never abort the whole snapshot.

PROC_DIR="${SYSDASH_PROC_DIR:-/proc}"
SYS_DIR="${SYSDASH_SYS_DIR:-/sys}"
LEASES_FILE="${SYSDASH_LEASES_FILE:-/tmp/dhcp.leases}"

case "$1" in
	list)
		printf '{"get":{}}\n'
		exit 0
		;;
	call)
		[ "$2" = "get" ] || { printf '{"error":"unknown method"}\n'; exit 1; }
		;;
	*)
		printf '{}\n'
		exit 0
		;;
esac

# Keep only a plain (possibly negative) integer. Anything else becomes 0 so
# a malformed sysfs value can never break the JSON number position.
num() {
	case "$1" in
		''|*[!0-9-]*) printf '0' ;;
		*) printf '%s' "$1" ;;
	esac
}

read_num() {
	[ -r "$1" ] || { printf '0'; return; }
	num "$(cat "$1" 2>/dev/null)"
}

# Single-line text, stripped of characters that would break a JSON string.
read_txt() {
	[ -r "$1" ] || { printf ''; return; }
	head -n 1 "$1" 2>/dev/null | sed 's/\\/\\\\/g; s/"/\\"/g; s/[[:cntrl:]]//g'
}

ts=$(date +%s 2>/dev/null)
ts=$(num "$ts")

# ---- uptime / load average -------------------------------------------------
uptime=$(awk 'NR==1{printf "%d", $1}' "$PROC_DIR/uptime" 2>/dev/null)
uptime=$(num "$uptime")

load1=$(awk 'NR==1{printf "%.2f", $1}' "$PROC_DIR/loadavg" 2>/dev/null); load1=${load1:-0}
load5=$(awk 'NR==1{printf "%.2f", $2}' "$PROC_DIR/loadavg" 2>/dev/null); load5=${load5:-0}
load15=$(awk 'NR==1{printf "%.2f", $3}' "$PROC_DIR/loadavg" 2>/dev/null); load15=${load15:-0}

# ---- CPU jiffies (raw cumulative counters, diffed in the browser) ----------
cpu_total=0
cpu_idle=0
if [ -r "$PROC_DIR/stat" ]; then
	line=$(awk '/^cpu /{print; exit}' "$PROC_DIR/stat" 2>/dev/null)
	if [ -n "$line" ]; then
		set -- $line
		shift
		idx=0
		for v in "$@"; do
			idx=$((idx + 1))
			cpu_total=$((cpu_total + $(num "$v")))
			# field 4 = idle, field 5 = iowait (both count as non-busy)
			case "$idx" in 4|5) cpu_idle=$((cpu_idle + $(num "$v"))) ;; esac
		done
	fi
fi

# ---- memory (kB) -----------------------------------------------------------
mem_total=0; mem_free=0; mem_avail=0; mem_buffers=0; mem_cached=0
if [ -r "$PROC_DIR/meminfo" ]; then
	eval "$(awk '
		/^MemTotal:/     { t=$2 }
		/^MemFree:/      { f=$2 }
		/^MemAvailable:/ { a=$2 }
		/^Buffers:/      { b=$2 }
		/^Cached:/       { c=$2 }
		END { printf "mem_total=%d mem_free=%d mem_avail=%d mem_buffers=%d mem_cached=%d\n", t, f, a, b, c }
	' "$PROC_DIR/meminfo")"
fi

# ---- per-interface cumulative traffic (bytes) ------------------------------
traffic_json=""
if [ -r "$PROC_DIR/net/dev" ]; then
	traffic_json=$(awk '
		NR>2 && $2 ~ /^[0-9]+$/ && $10 ~ /^[0-9]+$/ {
			d=$1; sub(/:$/, "", d); gsub(/["\\]/, "", d);
			if (d == "" || d == "lo") next;
			printf "%s{\"device\":\"%s\",\"rx\":%s,\"tx\":%s}", sep, d, $2, $10;
			sep=",";
		}
	' "$PROC_DIR/net/dev")
fi

# ---- DHCP leases (online terminals) ----------------------------------------
leases_json=""
if [ -r "$LEASES_FILE" ]; then
	leases_json=$(awk '
		NF>=4 {
			mac=$2; ip=$3; host=$4;
			gsub(/["\\]/, "", mac); gsub(/["\\]/, "", ip);
			gsub(/["\\]/, "", host); gsub(/[[:cntrl:]]/, "", host);
			if (host == "" || host == "*") host=ip;
			printf "%s{\"mac\":\"%s\",\"ip\":\"%s\",\"host\":\"%s\"}", sep, mac, ip, host;
			sep=",";
		}
	' "$LEASES_FILE")
fi

# ---- thermal zones (millidegrees Celsius) ----------------------------------
thermal_json=""
tsep=""
for z in "$SYS_DIR"/class/thermal/thermal_zone[0-9]*; do
	[ -r "$z/temp" ] || continue
	t=$(read_num "$z/temp")
	[ "$t" = "0" ] && continue
	type=$(read_txt "$z/type")
	[ -n "$type" ] || type="thermal"
	thermal_json="${thermal_json}${tsep}{\"type\":\"${type}\",\"millic\":${t}}"
	tsep=","
done

# ---- PWM fan: rpm / pwm duty / thermal cooling state -----------------------
# TR3600 exposes pwm-fan through hwmon (fan1_input, pwm1). Devices without a
# fan simply leave rpm/pwm at -1 and the view shows "--" instead of a bogus 0.
fan_name=""; fan_rpm=-1; fan_pwm=-1; fan_pwm_max=255; fan_state=-1; fan_state_max=-1
for h in "$SYS_DIR"/class/hwmon/hwmon[0-9]*; do
	[ -d "$h" ] || continue
	for f in "$h"/fan[0-9]*_input; do
		[ -r "$f" ] || continue
		fan_rpm=$(read_num "$f")
		fan_name=$(read_txt "$h/name")
		break
	done
	for p in "$h"/pwm[0-9]*; do
		case "$p" in *_enable|*_mode|*_freq|*_polarity) continue ;; esac
		[ -r "$p" ] || continue
		fan_pwm=$(read_num "$p")
		[ -r "$h/pwm_max" ] && fan_pwm_max=$(read_num "$h/pwm_max")
		break
	done
	[ "$fan_rpm" -ge 0 ] && break
done
fan_name=$(printf '%s' "$fan_name" | sed 's/["\\]/ /g; s/[[:cntrl:]]//g')

for c in "$SYS_DIR"/class/thermal/cooling_device[0-9]*; do
	[ -r "$c/type" ] || continue
	ct=$(read_txt "$c/type")
	case "$ct" in
		*fan*|*Fan*|*pwm*|*PWM*)
			fan_state=$(read_num "$c/cur_state")
			fan_state_max=$(read_num "$c/max_state")
			break
			;;
	esac
done

# ---- conntrack count --------------------------------------------------------
conntrack=-1
[ -r "$PROC_DIR/sys/net/netfilter/nf_conntrack_count" ] && \
	conntrack=$(read_num "$PROC_DIR/sys/net/netfilter/nf_conntrack_count")

printf '{"ts":%s,"uptime":%s,"load":[%s,%s,%s],"cpu":{"total":%s,"idle":%s},"memory":{"total":%s,"free":%s,"available":%s,"buffers":%s,"cached":%s},"traffic":[%s],"leases":[%s],"thermal":[%s],"fan":{"name":"%s","rpm":%s,"pwm":%s,"pwm_max":%s,"state":%s,"state_max":%s},"conntrack":%s}\n' \
	"$ts" "$uptime" "$load1" "$load5" "$load15" \
	"$cpu_total" "$cpu_idle" \
	"$mem_total" "$mem_free" "$mem_avail" "$mem_buffers" "$mem_cached" \
	"$traffic_json" "$leases_json" "$thermal_json" \
	"$fan_name" "$fan_rpm" "$fan_pwm" "$fan_pwm_max" "$fan_state" "$fan_state_max" \
	"$conntrack"
