#!/bin/sh
# sysdashboard -- rpcd data provider for luci-app-sysdashboard
#
# Purely read-only. Takes ONE snapshot from /proc, /sys and the DHCP lease file
# and prints a single JSON object. The LuCI view does the delta calculation
# (rates, CPU usage) between two snapshots, so this script never sleeps,
# never keeps state and never writes anything.
#
# rpcd protocol:
#   <script> list       -> {"get":{}}
#   <script> call get   -> snapshot JSON (params on stdin are ignored)
#
# All paths can be overridden for the sandbox test in
# scripts/test-sysdashboard.sh:
#   SYSDASH_PROC_DIR / SYSDASH_SYS_DIR / SYSDASH_LEASES_FILE
#
# Deliberately NOT using "set -e": every source may be absent on a given
# device (no fan, no thermal zone, no conntrack, no leases). A failed read
# must degrade to -1 / empty array, never abort the whole snapshot.

PROC_DIR="${SYSDASH_PROC_DIR:-/proc}"
SYS_DIR="${SYSDASH_SYS_DIR:-/sys}"
LEASES_FILE="${SYSDASH_LEASES_FILE:-/tmp/dhcp.leases}"
# 邻居表（ARP）与 ip 命令也可注入，沙箱测试用假文件/假命令替换
ARP_FILE="${SYSDASH_ARP_FILE:-$PROC_DIR/net/arp}"
IP_CMD="${SYSDASH_IP_CMD:-ip}"
UBUS_CMD="${SYSDASH_UBUS_CMD:-ubus}"

case "$1" in
	list)
		printf '{"get":{}}\n'
		exit 0
		;;
	call)
		[ "$2" = "get" ] || { printf '{"error":"unknown method"}\n'; exit 1; }
		;;
	*)
		printf '{}\n'
		exit 0
		;;
esac

# Keep only a plain (possibly negative) integer. Anything else becomes 0 so
# a malformed sysfs value can never break the JSON number position.
num() {
	case "$1" in
		''|*[!0-9-]*) printf '0' ;;
		*) printf '%s' "$1" ;;
	esac
}

read_num() {
	[ -r "$1" ] || { printf '0'; return; }
	num "$(cat "$1" 2>/dev/null)"
}

# Single-line text, stripped of characters that would break a JSON string.
read_txt() {
	[ -r "$1" ] || { printf ''; return; }
	head -n 1 "$1" 2>/dev/null | sed 's/\\/\\\\/g; s/"/\\"/g; s/[[:cntrl:]]//g'
}

ts=$(date +%s 2>/dev/null)
ts=$(num "$ts")

# ---- uptime / load average -------------------------------------------------
uptime=$(awk 'NR==1{printf "%d", $1}' "$PROC_DIR/uptime" 2>/dev/null)
uptime=$(num "$uptime")

load1=$(awk 'NR==1{printf "%.2f", $1}' "$PROC_DIR/loadavg" 2>/dev/null); load1=${load1:-0}
load5=$(awk 'NR==1{printf "%.2f", $2}' "$PROC_DIR/loadavg" 2>/dev/null); load5=${load5:-0}
load15=$(awk 'NR==1{printf "%.2f", $3}' "$PROC_DIR/loadavg" 2>/dev/null); load15=${load15:-0}

# ---- CPU jiffies (raw cumulative counters, diffed in the browser) ----------
cpu_total=0
cpu_idle=0
if [ -r "$PROC_DIR/stat" ]; then
	line=$(awk '/^cpu /{print; exit}' "$PROC_DIR/stat" 2>/dev/null)
	if [ -n "$line" ]; then
		set -- $line
		shift
		idx=0
		for v in "$@"; do
			idx=$((idx + 1))
			cpu_total=$((cpu_total + $(num "$v")))
			# field 4 = idle, field 5 = iowait (both count as non-busy)
			case "$idx" in 4|5) cpu_idle=$((cpu_idle + $(num "$v"))) ;; esac
		done
	fi
fi

# ---- memory (kB) -----------------------------------------------------------
mem_total=0; mem_free=0; mem_avail=0; mem_buffers=0; mem_cached=0
if [ -r "$PROC_DIR/meminfo" ]; then
	eval "$(awk '
		/^MemTotal:/     { t=$2 }
		/^MemFree:/      { f=$2 }
		/^MemAvailable:/ { a=$2 }
		/^Buffers:/      { b=$2 }
		/^Cached:/       { c=$2 }
		END { printf "mem_total=%d mem_free=%d mem_avail=%d mem_buffers=%d mem_cached=%d\n", t, f, a, b, c }
	' "$PROC_DIR/meminfo")"
fi

# ---- per-interface cumulative traffic (bytes) ------------------------------
traffic_json=""
if [ -r "$PROC_DIR/net/dev" ]; then
	traffic_json=$(awk '
		NR>2 && $2 ~ /^[0-9]+$/ && $10 ~ /^[0-9]+$/ {
			d=$1; sub(/:$/, "", d); gsub(/["\\]/, "", d);
			if (d == "" || d == "lo") next;
			printf "%s{\"device\":\"%s\",\"rx\":%s,\"tx\":%s}", sep, d, $2, $10;
			sep=",";
		}
	' "$PROC_DIR/net/dev")
fi

# ---- DHCP leases (online terminals) ----------------------------------------
leases_json=""
if [ -r "$LEASES_FILE" ]; then
	leases_json=$(awk '
		NF>=4 {
			mac=$2; ip=$3; host=$4;
			gsub(/["\\]/, "", mac); gsub(/["\\]/, "", ip);
			gsub(/["\\]/, "", host); gsub(/[[:cntrl:]]/, "", host);
			if (host == "" || host == "*") host=ip;
			printf "%s{\"mac\":\"%s\",\"ip\":\"%s\",\"host\":\"%s\"}", sep, mac, ip, host;
			sep=",";
		}
	' "$LEASES_FILE")
fi

# ---- thermal zones (millidegrees Celsius) ----------------------------------
thermal_json=""
tsep=""
for z in "$SYS_DIR"/class/thermal/thermal_zone[0-9]*; do
	[ -r "$z/temp" ] || continue
	t=$(read_num "$z/temp")
	[ "$t" = "0" ] && continue
	type=$(read_txt "$z/type")
	[ -n "$type" ] || type="thermal"
	thermal_json="${thermal_json}${tsep}{\"type\":\"${type}\",\"millic\":${t}}"
	tsep=","
done

# ---- PWM fan: rpm / pwm duty / thermal cooling state -----------------------
# TR3600 exposes pwm-fan through hwmon (fan1_input, pwm1). Devices without a
# fan simply leave rpm/pwm at -1 and the view shows "--" instead of a bogus 0.
fan_name=""; fan_rpm=-1; fan_pwm=-1; fan_pwm_max=255; fan_state=-1; fan_state_max=-1
for h in "$SYS_DIR"/class/hwmon/hwmon[0-9]*; do
	[ -d "$h" ] || continue
	for f in "$h"/fan[0-9]*_input; do
		[ -r "$f" ] || continue
		fan_rpm=$(read_num "$f")
		fan_name=$(read_txt "$h/name")
		break
	done
	for p in "$h"/pwm[0-9]*; do
		case "$p" in *_enable|*_mode|*_freq|*_polarity) continue ;; esac
		[ -r "$p" ] || continue
		fan_pwm=$(read_num "$p")
		[ -r "$h/pwm_max" ] && fan_pwm_max=$(read_num "$h/pwm_max")
		break
	done
	[ "$fan_rpm" -ge 0 ] && break
done
fan_name=$(printf '%s' "$fan_name" | sed 's/["\\]/ /g; s/[[:cntrl:]]//g')

for c in "$SYS_DIR"/class/thermal/cooling_device[0-9]*; do
	[ -r "$c/type" ] || continue
	ct=$(read_txt "$c/type")
	case "$ct" in
		*fan*|*Fan*|*pwm*|*PWM*)
			fan_state=$(read_num "$c/cur_state")
			fan_state_max=$(read_num "$c/max_state")
			break
			;;
	esac
done

# ---- conntrack count --------------------------------------------------------
conntrack=-1
[ -r "$PROC_DIR/sys/net/netfilter/nf_conntrack_count" ] && \
	conntrack=$(read_num "$PROC_DIR/sys/net/netfilter/nf_conntrack_count")

# ---- 在线设备：DHCP 租约 + ARP 邻居表 合并（按 MAC 去重）-------------------
# 为什么不能只看租约：租约表在 /tmp（重启即空），无限租期（leasetime=0）的
# 客户端永不续约，静态 IP 设备根本不发 DHCP——三种情况下租约里都没有它们，
# 但 ARP 表里能看到。合并后「在线设备」才是真的在线设备。
clients_json=""
if [ -r "$LEASES_FILE" ] || [ -r "$ARP_FILE" ]; then
	clients_json=$(awk -v leases="$LEASES_FILE" -v arp="$ARP_FILE" '
		function clean(s) { gsub(/["\\]/, "", s); gsub(/[[:cntrl:]]/, "", s); return s }
		BEGIN {
			n = 0
			if (leases != "") {
				while ((getline line < leases) > 0) {
					split(line, f, " ")
					if (f[2] == "") continue
					mac = tolower(clean(f[2])); ip = clean(f[3]); host = clean(f[4])
					if (host == "" || host == "*") host = ip
					if (mac in seen) continue
					seen[mac] = 1
					printf "%s{\"mac\":\"%s\",\"ip\":\"%s\",\"host\":\"%s\",\"source\":\"dhcp\",\"online\":1}", (n++ ? "," : ""), mac, ip, host
				}
				close(leases)
			}
			if (arp != "") {
				while ((getline line < arp) > 0) {
					if (line ~ /^IP address/) continue
					split(line, a, " ")
					if (a[1] == "" || a[4] == "") continue
					mac = tolower(clean(a[4])); ip = clean(a[1])
					if (mac == "00:00:00:00:00:00") continue
					if (mac in seen) continue
					seen[mac] = 1
					printf "%s{\"mac\":\"%s\",\"ip\":\"%s\",\"host\":\"%s\",\"source\":\"arp\",\"online\":%d}", (n++ ? "," : ""), mac, ip, ip, (a[3] == "0x2" ? 1 : 0)
				}
				close(arp)
			}
		}')
fi

# ---- 上联（默认路由所在接口）-----------------------------------------------
# 不依赖 netifd：QModem 的 wwan0 由 quectel-CM 直接配 IP/路由，netifd 里没有它，
# 所以 LuCI 自带的「互联网」判定会说未连接，而这里直接读内核路由。
uplink_json='{"connected":false,"device":"","gateway":"","ip":""}'
route=$("$IP_CMD" -4 route 2>/dev/null | awk '
	/^default/ {
		d = ""; g = ""; m = 0
		for (i = 1; i <= NF; i++) {
			if ($i == "via") g = $(i + 1)
			if ($i == "dev") d = $(i + 1)
			if ($i == "metric") m = $(i + 1)
		}
		if (d != "" && (!best_set || m + 0 < best)) { best = m + 0; bd = d; bg = g; best_set = 1 }
	}
	END { if (best_set) printf "%s %s", bd, bg }
')
if [ -n "$route" ]; then
	set -- $route
	rdev=$(printf '%s' "$1" | sed 's/["\\]//g')
	rgw=$(printf '%s' "${2:-}" | sed 's/["\\]//g')
	raddr=$("$IP_CMD" -4 -o addr show dev "$rdev" 2>/dev/null | awk 'NR==1{print $4}' | sed 's/["\\]//g')
	uplink_json="{\"connected\":true,\"device\":\"$rdev\",\"gateway\":\"$rgw\",\"ip\":\"$raddr\"}"
fi

# ---- 运营商：从 QModem 的 cell_info 读 MCC/MNC（不抢 AT 口）----------------
# 只做「品牌名 + 主色」，不内置 logo 图片：商标图片随固件分发不合适；
# 视图用彩色圆点 + 名称表达，后续想换真 logo 只需加静态资源。
carrier_json='{"mcc":"","mnc":"","name":"","key":"","color":""}'
signal_json='{"mode":"","duplex":"","rsrp":0,"rsrq":0,"sinr":0,"rssi":0,"cqi":0,"tx_power":0,"srxlev":0,"tac":"","cell_id":"","pci":"","earfcn":"","bw":""}'
if command -v "$UBUS_CMD" >/dev/null 2>&1; then
	sec=$(uci -q show qmodem 2>/dev/null | sed -n 's/^qmodem\.\([^.=]*\)=modem-device$/\1/p' | head -n 1)
	[ -n "$sec" ] || sec="2_1"
	cell=$("$UBUS_CMD" call qmodem cell_info "{\"config_section\":\"$sec\"}" 2>/dev/null)
	if [ -n "$cell" ]; then
		cell_val() {
			printf '%s\n' "$cell" | awk -v k="\"$1\"" '$0 ~ ("\"key\": *" k) { getline; print; exit }' |
				sed -n 's/.*"value": *"\([^"]*\)".*/\1/p'
		}
		mcc=$(cell_val MCC)
		mnc=$(cell_val MNC)
		case "$mcc$mnc" in
			46000|46002|46004|46007|46008) ck=cmcc;    cn='中国移动'; cc='#009FE3' ;;
			46001|46006|46009)            ck=unicom;  cn='中国联通'; cc='#E60012' ;;
			46003|46005|46011)            ck=telecom; cn='中国电信'; cc='#004B9B' ;;
			46015)                        ck=cbn;     cn='中国广电'; cc='#FF6A00' ;;
			*)
				if [ -n "$mcc" ]; then ck=other; cn="$mcc$mnc"; cc='#8a8a8a'; fi
				;;
		esac
		if [ -n "${ck:-}" ]; then
			carrier_json="{\"mcc\":\"$mcc\",\"mnc\":\"$mnc\",\"name\":\"$cn\",\"key\":\"$ck\",\"color\":\"$cc\"}"
		fi
		# 信号量：只取数值型字段（缺失一律 0），文本字段去引号防坏 JSON
		sig_num() { v=$(cell_val "$1"); case "$v" in ''|*[!0-9-]*) printf '0' ;; *) printf '%s' "$v" ;; esac; }
		sig_txt() { cell_val "$1" | sed 's/["\\]//g; s/[[:cntrl:]]//g'; }
		signal_json=$(printf '{"mode":"%s","duplex":"%s","rsrp":%s,"rsrq":%s,"sinr":%s,"rssi":%s,"cqi":%s,"tx_power":%s,"srxlev":%s,"tac":"%s","cell_id":"%s","pci":"%s","earfcn":"%s","bw":"%s"}' \
			"$(sig_txt network_mode)" "$(sig_txt 'Duplex Mode')" \
			"$(sig_num RSRP)" "$(sig_num RSRQ)" "$(sig_num SINR)" "$(sig_num RSSI)" \
			"$(sig_num CQI)" "$(sig_num 'TX Power')" "$(sig_num Srxlev)" "$(sig_txt TAC)" \
			"$(sig_txt 'Cell ID')" "$(sig_txt 'Physical Cell ID')" "$(sig_txt EARFCN)" "$(sig_txt 'DL Bandwidth')")
	fi
fi

# ---- 小区/频段、流量统计、清零计划 ----------------------------------------
# 全部来自 QModem 的只读查询（不抢 AT 口）：
#   get_current_band          频段/信道/带宽/角色（PCC 即单载波，多载波时会有 scc）
#   get_stats                 模组自带的累计收发字节（跨重启持久）
#   get_traffic_reset_schedule 每月清零设置
# 频率只对常见 LTE 频段按 EARFCN 换算，NR 不硬算（避免给出错误数字）。
cell_json='{"band":"","band_name":"","channel":"","channel_type":"","dl_bw":"","ul_bw":"","role":"","freq_mhz":""}'
usage_json='{"rx":0,"tx":0,"since":0,"reset_enabled":false,"reset_day":1}'

jget() {
	printf '%s' "$1" | sed -n "s/.*\"$2\": *\"\([^\"]*\)\".*/\1/p" | head -n 1
}
jnum() {
	printf '%s' "$1" | sed -n "s/.*\"$2\": *\([0-9][0-9]*\).*/\1/p" | head -n 1
}
jbool() {
	printf '%s' "$1" | sed -n "s/.*\"$2\": *\(true\|false\).*/\1/p" | head -n 1
}

if command -v "$UBUS_CMD" >/dev/null 2>&1 && [ -n "${sec:-}" ]; then
	band_raw=$("$UBUS_CMD" call qmodem get_current_band "{\"config_section\":\"$sec\"}" 2>/dev/null)
	if [ -n "$band_raw" ]; then
		b_num=$(jget "$band_raw" band)
		b_name=$(jget "$band_raw" band_name)
		b_ch=$(jget "$band_raw" channel)
		b_ctype=$(jget "$band_raw" channel_type)
		b_dl=$(jget "$band_raw" dl_bandwidth)
		b_ul=$(jget "$band_raw" ul_bandwidth)
		b_role=$(jget "$band_raw" role)
		b_freq=""
		case "$b_num" in
			1)  [ -n "$b_ch" ] && b_freq=$(awk -v n="$b_ch" 'BEGIN{printf "%.1f", 2110 + 0.1 * (n - 0)}') ;;
			3)  [ -n "$b_ch" ] && b_freq=$(awk -v n="$b_ch" 'BEGIN{printf "%.1f", 1805 + 0.1 * (n - 1200)}') ;;
			5)  [ -n "$b_ch" ] && b_freq=$(awk -v n="$b_ch" 'BEGIN{printf "%.1f", 869 + 0.1 * (n - 2400)}') ;;
			7)  [ -n "$b_ch" ] && b_freq=$(awk -v n="$b_ch" 'BEGIN{printf "%.1f", 2620 + 0.1 * (n - 2750)}') ;;
			8)  [ -n "$b_ch" ] && b_freq=$(awk -v n="$b_ch" 'BEGIN{printf "%.1f", 925 + 0.1 * (n - 3450)}') ;;
			20) [ -n "$b_ch" ] && b_freq=$(awk -v n="$b_ch" 'BEGIN{printf "%.1f", 791 + 0.1 * (n - 6150)}') ;;
			28) [ -n "$b_ch" ] && b_freq=$(awk -v n="$b_ch" 'BEGIN{printf "%.1f", 758 + 0.1 * (n - 9210)}') ;;
			38) [ -n "$b_ch" ] && b_freq=$(awk -v n="$b_ch" 'BEGIN{printf "%.1f", 2570 + 0.1 * (n - 37750)}') ;;
			39) [ -n "$b_ch" ] && b_freq=$(awk -v n="$b_ch" 'BEGIN{printf "%.1f", 1880 + 0.1 * (n - 38250)}') ;;
			40) [ -n "$b_ch" ] && b_freq=$(awk -v n="$b_ch" 'BEGIN{printf "%.1f", 2300 + 0.1 * (n - 38650)}') ;;
			41) [ -n "$b_ch" ] && b_freq=$(awk -v n="$b_ch" 'BEGIN{printf "%.1f", 2496 + 0.1 * (n - 39650)}') ;;
		esac
		cell_json=$(printf '{"band":"%s","band_name":"%s","channel":"%s","channel_type":"%s","dl_bw":"%s","ul_bw":"%s","role":"%s","freq_mhz":"%s"}' \
			"$b_num" "$b_name" "$b_ch" "$b_ctype" "$b_dl" "$b_ul" "$b_role" "$b_freq")
	fi

	stats_raw=$("$UBUS_CMD" call qmodem get_stats "{\"config_section\":\"$sec\"}" 2>/dev/null)
	s_rx=0; s_tx=0
	[ -n "$stats_raw" ] && s_rx=$(jnum "$stats_raw" total_rx_bytes)
	[ -n "$stats_raw" ] && s_tx=$(jnum "$stats_raw" total_tx_bytes)

	sch_raw=$("$UBUS_CMD" call qmodem get_traffic_reset_schedule "{\"config_section\":\"$sec\"}" 2>/dev/null)
	s_en=false; s_day=1
	if [ -n "$sch_raw" ]; then
		e=$(jbool "$sch_raw" enabled); [ -n "$e" ] && s_en=$e
		d=$(jnum "$sch_raw" day); [ -n "$d" ] && s_day=$d
	fi

	# 本次连接起始时间：backend.json 的 generation 形如 "1074-1794760729"
	since=0
	if [ -r "/var/run/qmodem/${sec}_dir/backend.json" ]; then
		since=$(sed -n 's/.*"generation": *"[0-9]*-\{0,\}\([0-9]\{9,\}\)".*/\1/p' "/var/run/qmodem/${sec}_dir/backend.json" | head -n 1)
	fi

	usage_json=$(printf '{"rx":%s,"tx":%s,"since":%s,"reset_enabled":%s,"reset_day":%s}' \
		"$(num "${s_rx:-0}")" "$(num "${s_tx:-0}")" "$(num "${since:-0}")" "$s_en" "$(num "${s_day:-1}")")
fi

# IPv6 全局地址（多数移动网络只给链路本地，此时留空由前端显示「未分配」）
ipv6_addr=""
if command -v "$IP_CMD" >/dev/null 2>&1 && [ -n "${rdev:-}" ]; then
	ipv6_addr=$("$IP_CMD" -6 -o addr show dev "$rdev" scope global 2>/dev/null | awk 'NR==1 {print $4}')
fi

# ---- 多 WAN 候选（供面板标签页切换）--------------------------------------
# 候选 = 默认路由里出现的设备 + 常见的 WAN 设备名（存在才列）。
# 每个候选给出：是否承载默认路由、IP、网关、metric、累计收发。
uplinks_json="[]"
if command -v "$IP_CMD" >/dev/null 2>&1; then
	route_all=$("$IP_CMD" -4 route 2>/dev/null | awk '/^default/ {d="";g="";m=0;for(i=1;i<=NF;i++){if($i=="via")g=$(i+1);if($i=="dev")d=$(i+1);if($i=="metric")m=$(i+1)}; if(d!="") printf "%s|%s|%s\n", d, g, m}')
	cands=$(printf '%s\n' "$route_all" | cut -d'|' -f1 | sed '/^$/d' | sort -u)
	for d in wwan0 wan usb0 wanusb; do
		[ -d "/sys/class/net/$d" ] && cands=$(printf '%s\n%s\n' "$cands" "$d")
	done
	cands=$(printf '%s\n' "$cands" | sed '/^$/d' | sort -u)
	sep=""
	for d in $cands; do
		line=$(printf '%s\n' "$route_all" | awk -F'|' -v d="$d" '$1==d {print; exit}')
		rgw=$(printf '%s' "$line" | cut -d'|' -f2)
		rmet=$(printf '%s' "$line" | cut -d'|' -f3)
		[ -n "$line" ] && rconn=true || rconn=false
		raddr=$("$IP_CMD" -4 -o addr show dev "$d" 2>/dev/null | awk 'NR==1{print $4}')
		rrx=0; rtx=0
		[ -r "$PROC_DIR/net/dev" ] && rrx=$(awk -v d="$d" '$1==d":" {print $2; exit}' "$PROC_DIR/net/dev")
		[ -r "$PROC_DIR/net/dev" ] && rtx=$(awk -v d="$d" '$1==d":" {print $10; exit}' "$PROC_DIR/net/dev")
		uplinks_json=$(printf '%s' "$uplinks_json" | sed 's/^\[//; s/\]$//')
		uplinks_json="[${uplinks_json}${sep}{\"device\":\"$d\",\"connected\":$rconn,\"ip\":\"${raddr:-}\",\"gateway\":\"${rgw:-}\",\"metric\":${rmet:-0},\"rx\":$(num "${rrx:-0}"),\"tx\":$(num "${rtx:-0}")}]"
		sep=","
	done
fi

# ---- 能力表 caps -----------------------------------------------------------
# 统一判定「某个部件现在有没有数据」，前端不再各写 if。原则：判不准就当不可用
# （宁可少显示一张卡，也不显示一张空卡）。
#   wan         默认路由所在设备存在且 operstate 不是 down
#   wifi        有射频且存在 AP 接口（无线被禁用时 iw dev 里没有 Interface）
#   wifi_clients 无线关联客户端 > 0
#   clients     租约 + ARP 合并后的在线设备 > 0
#   modem       qmodem 的 ubus 对象存在
#   signal      cell_info 给出了有效 RSRP（0 视为无效）
wifi_radios=0
for _r in "$SYS_DIR"/class/ieee80211/*; do
	[ -d "$_r" ] && wifi_radios=$((wifi_radios + 1))
done

wifi_ifaces=0
wifi_stations=0
if command -v iw >/dev/null 2>&1; then
	wifi_ifaces=$(iw dev 2>/dev/null | grep -c 'Interface' 2>/dev/null || true)
	wifi_ifaces=${wifi_ifaces:-0}
	for _w in $(iw dev 2>/dev/null | awk '/Interface/ {print $2}'); do
		_n=$(iw dev "$_w" station dump 2>/dev/null | grep -c 'Station' 2>/dev/null || true)
		wifi_stations=$((wifi_stations + ${_n:-0}))
	done
fi

wan_ok=false
if [ -n "$route" ]; then
	case "$(cat "$SYS_DIR/class/net/$rdev/operstate" 2>/dev/null)" in
		down) wan_ok=false ;;
		*)    wan_ok=true ;;
	esac
fi

wifi_ok=false
[ "$wifi_radios" -gt 0 ] && [ "$wifi_ifaces" -gt 0 ] && wifi_ok=true

wifi_clients_ok=false
[ "$wifi_ok" = true ] && [ "$wifi_stations" -gt 0 ] && wifi_clients_ok=true

# END 保证空输入也输出 0（空 awk 输入不会执行规则，会导致 printf %d 收到空串）
client_count=$(printf '%s' "$clients_json" | awk '{n += gsub(/"mac":/, "")} END {print n + 0}')
clients_ok=false
[ "$client_count" -gt 0 ] && clients_ok=true

modem_ok=false
if command -v "$UBUS_CMD" >/dev/null 2>&1; then
	"$UBUS_CMD" list 2>/dev/null | grep -qx 'qmodem' && modem_ok=true
fi

signal_ok=false
case "$signal_json" in
	*'"rsrp":0,'*|*'"rsrp":0}'*) ;;
	*) [ "$modem_ok" = true ] && signal_ok=true ;;
esac

caps_json=$(printf '{"wan":{"ok":%s,"device":"%s"},"wifi":{"ok":%s,"radios":%d,"ifaces":%d},"wifi_clients":{"ok":%s,"count":%d},"clients":{"ok":%s,"count":%d},"modem":{"ok":%s},"signal":{"ok":%s}}' \
	"$wan_ok" "${rdev:-}" "$wifi_ok" "$wifi_radios" "$wifi_ifaces" \
	"$wifi_clients_ok" "$wifi_stations" "$clients_ok" "$client_count" \
	"$modem_ok" "$signal_ok")

printf '{"ts":%s,"uptime":%s,"load":[%s,%s,%s],"cpu":{"total":%s,"idle":%s},"memory":{"total":%s,"free":%s,"available":%s,"buffers":%s,"cached":%s},"traffic":[%s],"leases":[%s],"clients":[%s],"uplink":%s,"uplinks":%s,"carrier":%s,"signal":%s,"caps":%s,"cell":%s,"usage":%s,"ipv6":"%s","thermal":[%s],"fan":{"name":"%s","rpm":%s,"pwm":%s,"pwm_max":%s,"state":%s,"state_max":%s},"conntrack":%s}\n' \
	"$ts" "$uptime" "$load1" "$load5" "$load15" \
	"$cpu_total" "$cpu_idle" \
	"$mem_total" "$mem_free" "$mem_avail" "$mem_buffers" "$mem_cached" \
	"$traffic_json" "$leases_json" "$clients_json" "$uplink_json" "$uplinks_json" "$carrier_json" "$signal_json" "$caps_json" "$cell_json" "$usage_json" "$ipv6_addr" "$thermal_json" \
	"$fan_name" "$fan_rpm" "$fan_pwm" "$fan_pwm_max" "$fan_state" "$fan_state_max" \
	"$conntrack"
