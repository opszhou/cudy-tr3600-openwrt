# ===== 精简实用型组合（lite）—— 需求清单的精简版 =====
# = lite（不含 modem 基座）减去：ttyd / netspeedtest / statistics / mwan3 / macvlan
# 保留：argon 主题、turboacc、nikki、ddns-go、acme、socat、UPnP、SFTP、dufs（文件+WebDAV）、SQM、nlbwmon、定时重启
# 额外依赖 feed：kenzok8 / small（argon-config、turboacc、ddns-go 所需）

# ---- 基础与界面 ----
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ---- 基础网络与优化 ----
CONFIG_PACKAGE_luci-app-turboacc=y
# NFT FULLCONE 特性默认 y，但它依赖的 kmod-nft-fullcone 已被上游移除（main 与 packages feed
# 均无此包），构建到装 rootfs 阶段报 "kmod-nft-fullcone (no such package)" 而整体失败。
# 关掉该子特性；BBR / 流卸载不受影响。
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_NFT_FULLCONE is not set
# 流卸载内核模块：2026-10 起上游将 flow-offload / hw-flow-offload 合并为 kmod-nft-offload
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y

# ---- 远程访问与端口控制 ----
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_luci-i18n-acme-zh-cn=y
CONFIG_PACKAGE_acme-acmesh=y
# socat 的 LuCI 面板已被上游 feeds 删除，保留核心（CLI 可用）
CONFIG_PACKAGE_socat=y
# WOL 网络唤醒（官方 luci 保留版；wolplus 上游已无 feed 化仓库）
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
# miniupnpd 是虚拟名（PROVIDES），defconfig 会规范化为真实变体包名；审计要求写真实名
CONFIG_PACKAGE_miniupnpd-nftables=y

# ---- 文件服务与存储 ----
CONFIG_PACKAGE_openssh-sftp-server=y
# dufs：网页文件浏览器 + WebDAV 一体（官方源，Rust 单二进制，procd/uci 管理）
# 首启预设 8080 端口、根目录 /mnt、只读；开写与认证见 README
CONFIG_PACKAGE_dufs=y

# ---- USB 存储（U 盘/移动硬盘开箱即挂载；基础 kmod-usb-storage 已在 modem.list）----
# ⚠️ Kconfig 不支持行内注释（conf 会把 "y # ..." 整段当值导致包被静默丢弃），注释必须独立成行
# UAS 高速协议
CONFIG_PACKAGE_kmod-usb-storage-uas=y
# ext4
CONFIG_PACKAGE_kmod-fs-ext4=y
# exFAT（main 分支包名，非旧教程的 exfat0137）
CONFIG_PACKAGE_kmod-fs-exfat=y
# NTFS（内核原生 ntfs3）
CONFIG_PACKAGE_kmod-fs-ntfs3=y
# FAT32
CONFIG_PACKAGE_kmod-fs-vfat=y
# 自动挂载 + LuCI 挂载点页（fstools 提供）
CONFIG_PACKAGE_block-mount=y

# ---- USB 网卡与 USB 转串口芯片（第二 WAN、串口调试/救砖；lite 与 ultimate 共用）----
# 包名均已在容器内 defconfig 实测幸存（OpenWrt main），非臆测。
# 注意：这些都是芯片级驱动，插上对应设备才会加载，日常不影响启动。
# RTL8152/8153/8156 —— 最常见的 1G/2.5G USB 网卡（绿联、山泽等绝大多数成品）
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
# RTL8150 —— 老式百兆 USB 网卡（少量存量设备）
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
# ASIX AX88172/88772 —— 百兆/千兆 USB 网卡（较老但常见）
CONFIG_PACKAGE_kmod-usb-net-asix=y
# ASIX AX88179/88179A —— 2.5G/千兆 USB 网卡
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
# CDC-EEM —— 部分 4G/5G 模块与手机共享网络走这个协议
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
# CH340/CH341 —— ESP32/Arduino/路由器救砖线最常用
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
# CP210x —— CP2102/CP2104（ESP32 开发板标配）
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
# PL2303 —— 老牌 USB 转串口线
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
# FTDI FT232 —— 工业/调试用 USB 转串口
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y

# ---- 网络质量、监控与维护 ----
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_sqm-scripts=y
# vnstat 面板与核心均已被上游 feeds 删除，改用官方 nlbwmon（按主机流量统计）
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
# autoreboot 面板已被上游 feeds 删除，定时重启由 uci-defaults 写入 crontab 实现
# （见 common/files/etc/uci-defaults/99-router-presets）
# kenzok8/small 的 luci-app-clashoo 给自家 i18n 写了 DEFAULT:=LUCI_LANG_zh_Hans||...，
# 开中文即自动入选（HIDDEN 藏在菜单里）；app 本体不装，只多一个几 KB 的 .lmo 语言文件，
# 显式关掉保持固件干净（全 feed 仅此一家这么写，2026-11 实查）
# CONFIG_PACKAGE_luci-i18n-clashoo-zh-cn is not set
