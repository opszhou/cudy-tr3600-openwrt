# ===== 精简实用型组合（lite）—— 需求清单的精简版 =====
# = lite（不含 modem 基座）减去：ttyd / filebrowser / netspeedtest / statistics / mwan3 / macvlan
# 保留：argon 主题、turboacc、nikki、ddns-go、acme、socat、UPnP、SFTP、WebDAV、SQM、vnstat、autoreboot
# 额外依赖 feed：kenzok8 / small（argon-config、turboacc、ddns-go 所需）

# ---- 基础与界面 ----
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ---- 基础网络与优化 ----
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_kmod-nft-flow-offload=y
CONFIG_PACKAGE_kmod-nft-hw-flow-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y

# ---- 远程访问与端口控制 ----
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_luci-i18n-acme-zh-cn=y
CONFIG_PACKAGE_acme-acmesh=y
# socat 的 LuCI 面板已被上游 feeds 删除，保留核心（CLI 可用）
CONFIG_PACKAGE_socat=y
# WOL 网络唤醒（官方 luci 保留版；wolplus 上游已无 feed 化仓库）
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_miniupnpd=y

# ---- 文件服务与存储 ----
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_lighttpd=y
CONFIG_PACKAGE_lighttpd-mod-webdav=y
CONFIG_PACKAGE_lighttpd-mod-auth=y
CONFIG_PACKAGE_lighttpd-mod-authn_file=y

# ---- USB 存储（U 盘/移动硬盘开箱即挂载；基础 kmod-usb-storage 已在 modem.list）----
CONFIG_PACKAGE_kmod-usb-storage-uas=y          # UAS 高速协议
CONFIG_PACKAGE_kmod-fs-ext4=y                  # ext4
CONFIG_PACKAGE_kmod-fs-exfat=y                 # exFAT（main 分支包名，非旧教程的 exfat0137）
CONFIG_PACKAGE_kmod-fs-ntfs3=y                 # NTFS（内核原生 ntfs3）
CONFIG_PACKAGE_kmod-fs-vfat=y                  # FAT32
CONFIG_PACKAGE_block-mount=y                   # 自动挂载 + LuCI 挂载点页（fstools 提供）

# ---- 网络质量、监控与维护 ----
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_sqm-scripts=y
# vnstat 面板与核心均已被上游 feeds 删除，改用官方 nlbwmon（按主机流量统计）
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
# autoreboot 面板已被上游 feeds 删除，定时重启由 uci-defaults 写入 crontab 实现
# （见 common/files/etc/uci-defaults/99-router-presets）
