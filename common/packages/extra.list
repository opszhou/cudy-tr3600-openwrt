# ===== 全能型增量包（extra）—— 在 lite 之上追加的部分 =====
# 需要额外 feed：kenzok8 / small（已在 common/feeds.append 启用）
# 不确定包名的行若在源中不存在，make defconfig 会忽略并告警，构建不受阻

# ---- 第一梯队：核心基础设施 ----
# 现代化主题（argon 主题本体与配置面板均在 kenzok8 源；官方 luci 源无 argon，2026-10 实测）
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
# 网页终端
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_ttyd=y
# 网络加速：流卸载 + BBR（面板在 kenzok8 源；内核模块官方源）
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_kmod-nft-flow-offload=y
CONFIG_PACKAGE_kmod-nft-hw-flow-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
# 透明代理（nikki feed）
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
# 单口多拨/虚拟网卡
CONFIG_PACKAGE_kmod-macvlan=y
# 多 WAN 负载均衡/故障切换（NetPath：Rust + nftables 重写的 mwan3，支持 OpenWrt 24.x/25.x）
# feed: HikaruChang/NetPath（见 common/feeds.append，feed 递归扫描可同时收录 netpath 与 luci-app-netpath）
# 注意：依赖 rust/host 构建链，首次编译会多花约 15~25 分钟；LuCI 面板暂无中文语言包
CONFIG_PACKAGE_netpath=y
CONFIG_PACKAGE_luci-app-netpath=y

# ---- 第二梯队：远程访问与端口控制 ----
# 动态DNS（ddns-go，kenzok8 源）
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_ddns-go=y
# 证书自动化
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_luci-i18n-acme-zh-cn=y
CONFIG_PACKAGE_acme-acmesh=y
# 跨协议转发
# UPnP（安全模式由 uci-defaults 预设）
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_miniupnpd=y
# WOL：lite 已含 luci-app-wol（官方源）；wolplus 上游 siwind 2022-10 起停更，不收录

# ---- 第三梯队：文件服务与存储 ----
# SFTP
CONFIG_PACKAGE_openssh-sftp-server=y
# 网页文件管理器（kenzok8 源）
CONFIG_PACKAGE_luci-app-filebrowser=y
CONFIG_PACKAGE_filebrowser=y
# WebDAV（lighttpd 本体官方源；独立 LuCI 面板如源中缺失会被忽略）
CONFIG_PACKAGE_lighttpd=y
CONFIG_PACKAGE_lighttpd-mod-webdav=y
CONFIG_PACKAGE_lighttpd-mod-auth=y
CONFIG_PACKAGE_lighttpd-mod-authn_file=y

# ---- 第四梯队：网络质量、监控与维护 ----
# 智能限速
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_sqm-scripts=y
# 网络测速（kenzok8 源）
CONFIG_PACKAGE_luci-app-netspeedtest=y
# 实时性能监控：collectd + rrdtool（官方源，RRD 存 /tmp，常驻内存约 15~25MB）
# 替代 netdata（RAM 模式仍占 100MB+，512MB 设备负担大）；CPU/内存/负载/网卡/无线一体
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y
# 定时重启
