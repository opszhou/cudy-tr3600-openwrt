#!/bin/sh
# 通用默认配置预设（lite/ultimate 共用：UPnP 安全模式、定时重启、BBR）（uci-defaults，首次开机执行一次）

# ---- UPnP：默认启用安全模式（仅允许位于 DMZ/已映射主机的请求）
uci -q set upnpd.config.secure_mode=1
uci -q commit upnpd

# ---- 定时重启：每周一凌晨 04:30（crontab 实现；上游 luci-app-autoreboot 已删除）
CRON_LINE="30 4 * * 1 sleep 70 && touch /etc/banner && reboot"
crontab -l 2>/dev/null | grep -vF "touch /etc/banner && reboot" > /tmp/cron.tmp
echo "$CRON_LINE" >> /tmp/cron.tmp
crontab /tmp/cron.tmp && rm -f /tmp/cron.tmp
/etc/init.d/cron restart 2>/dev/null || true

# ---- BBR 拥塞控制默认启用（turboacc 面板亦可改）
if [ -d /sys/module/tcp_bbr ]; then
	echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
fi

exit 0
