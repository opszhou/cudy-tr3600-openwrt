#!/bin/sh
# 保证 LuCI(uhttpd) 独占 80 端口。
# 背景：WebDAV 用的 lighttpd 在 OpenWrt 里默认 server.port = 80 + document-root = /www，
# 与 uhttpd 直接撞车：谁先起谁占 80，另一个 bind() 失败（日志 "bind(): Address in use"），
# 浏览器打到 lighttpd 上就得到 403。首启把 lighttpd 挪到 8080，WebDAV 走 8080。
# 顺序很关键：先停 lighttpd 释放 80 → 改端口 → 起 uhttpd → 再起 lighttpd。
# uci-defaults 语义：首次开机执行一次后自删。
CFG=/etc/lighttpd/lighttpd.conf

# 1) 释放 80
[ -x /etc/init.d/lighttpd ] && /etc/init.d/lighttpd stop 2>/dev/null

# 2) 改端口（仅当它确实配成 80 时）
if [ -f "$CFG" ] && grep -qE '^[[:space:]]*server\.port[[:space:]]*=' "$CFG"; then
	sed -i 's/^[[:space:]]*server\.port[[:space:]]*=.*/server.port = 8080/' "$CFG"
fi

# 3) 确保 uhttpd 在 80 上跑起来
/etc/init.d/uhttpd enable 2>/dev/null || true
/etc/init.d/uhttpd restart 2>/dev/null || true

# 4) 再拉起 lighttpd（此时已改到 8080）
[ -x /etc/init.d/lighttpd ] && /etc/init.d/lighttpd start 2>/dev/null || true

exit 0
