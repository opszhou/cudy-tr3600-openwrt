#!/bin/sh
# 通用：lighttpd 的 WebDAV 共享预设（全设备共用，替代原来的 dufs）。
#
# 适用范围：所有带 lighttpd 的组合（当前 lite 组合的每台设备都装）。
# 未装 lighttpd 的设备在开头判断主配置存在性后退出，不产生副作用。
#
# 目标状态：监听 **8080**（80 留给 uhttpd/LuCI），根目录 `/mnt/webdav`，可读写。
#
# ⛔ 三个踩过的坑，改这个脚本前先读（run#78 刷机现场全部踩了一遍）：
#
# 1) 不要加 `set -u`。下面要 source /lib/functions.sh 拿 user_exists/user_add，
#    那个文件里的函数会引用未定义变量，严格模式让脚本在写任何配置之前就退出，
#    而且退出码非 0 导致 uci-defaults 不删除脚本——表面看「文件在、就是没生效」。
#    后果：lighttpd 用默认 80 启动，抢了 uhttpd 的端口，LuCI 403。
#
# 2) 不能在 conf.d 里重定义 server.document-root / server.port。
#    lighttpd 会报 "Duplicate config variable in conditional 0 global" 并拒绝启动。
#    正确做法是改主配置里的**变量**：主配置写的是
#    `server.document-root = server_root`，所以改 `var.server_root` 就够；
#    端口主配置里根本没写（默认 80），插一条 server.port。
#
# 3) 端口闸门必须在**启动之前**判定。先启动再检查等于已经把 80 抢了。
#    这里：改配置 → 解析端口 → 不是 8080 就整体回滚并停用，绝不让 lighttpd 起来。
#
# 注入点（仅供沙箱测试）：LW_MAIN_CONF / LW_CONF_DIR / LW_SHARE_DIR / LW_INIT / LW_BIN / LW_FUNCS

MAIN_CONF="${LW_MAIN_CONF:-/etc/lighttpd/lighttpd.conf}"
CONF_DIR="${LW_CONF_DIR:-/etc/lighttpd/conf.d}"
SHARE_DIR="${LW_SHARE_DIR:-/mnt/webdav}"
INIT="${LW_INIT:-/etc/init.d/lighttpd}"
BIN="${LW_BIN:-/usr/sbin/lighttpd}"
FRAGMENT="$CONF_DIR/zz-webdav-share.conf"
BACKUP="$MAIN_CONF.webdav-orig"

[ -f "$MAIN_CONF" ] || exit 0

# 首次执行留一份原始主配置，闸门失败用它整体回滚
[ -f "$BACKUP" ] || cp "$MAIN_CONF" "$BACKUP" 2>/dev/null

# user_exists / user_add 来自 functions.sh；出错也不影响主流程
if [ -f "${LW_FUNCS:-/lib/functions.sh}" ]; then
	. "${LW_FUNCS:-/lib/functions.sh}"
fi
if command -v user_exists >/dev/null 2>&1; then
	user_exists http || user_add http
fi

mkdir -p "$SHARE_DIR" "$CONF_DIR" 2>/dev/null
if id http >/dev/null 2>&1; then
	chown http:www-data "$SHARE_DIR" 2>/dev/null
fi
chmod 0775 "$SHARE_DIR" 2>/dev/null

# ---- 1) 根目录：改 var.server_root（主配置的 document-root 引用它）----
if grep -q '^var\.server_root = "/www/"' "$MAIN_CONF"; then
	sed -i 's|^var\.server_root = "/www/"|var.server_root = "/mnt/webdav/"|' "$MAIN_CONF"
fi

# ---- 2) 端口：主配置没有 server.port（默认 80），插一条 8080 ----
if ! grep -q '^server\.port' "$MAIN_CONF"; then
	sed -i 's|^server\.document-root|server.port                 = 8080\nserver.document-root|' "$MAIN_CONF"
fi

# ---- 3) conf.d 只放 WebDAV 启用（条件块，与包自带 30-webdav.conf 同构）----
cat > "$FRAGMENT" <<'FRAG'
# 由 /etc/uci-defaults/90-lighttpd-webdav 写入，重刷固件会自动重建。
# 端口与根目录在主配置里（server.port / var.server_root），这里只负责启用模块。
$HTTP["url"] =~ "^/" {
	webdav.activate       = "enable"
	webdav.is-readonly    = "disable"
	# 锁与属性库放 home_dir（/var/lib/lighttpd，init 已按 www-data 建好）；
	# /etc 属 root，http 用户写不进去，放那里会让 LOCK/UNLOCK 失败。
	webdav.sqlite-db-name = home_dir + "/webdav.db"
}
FRAG

# ---- 4) 端口闸门：解析不到 8080 就整体回滚、停用、绝不启动 ----
RESOLVED_PORT=""
if [ -x "$BIN" ]; then
	RESOLVED_PORT=$("$BIN" -p -f "$MAIN_CONF" 2>/dev/null \
		| sed -n 's/^[[:space:]]*server\.port[[:space:]]*=[[:space:]]*\([0-9]\{1,5\}\).*/\1/p' \
		| head -n1)
fi

if [ -n "$RESOLVED_PORT" ] && [ "$RESOLVED_PORT" != "8080" ]; then
	logger -t lighttpd-webdav "端口闸门拦截：解析出 server.port=$RESOLVED_PORT（期望 8080）。回滚主配置、撤掉片段、停用 lighttpd，避免抢占 uhttpd 的 80 导致 LuCI 无法访问。"
	[ -f "$BACKUP" ] && cp "$BACKUP" "$MAIN_CONF"
	rm -f "$FRAGMENT"
	"$INIT" stop 2>/dev/null
	"$INIT" disable 2>/dev/null
	exit 0
fi
if [ -z "$RESOLVED_PORT" ]; then
	# 解析不出（老版本 -p 输出格式差异）也不启动：宁可少一个 WebDAV，
	# 也不能赌它会不会退回 80 把 LuCI 抢掉。
	logger -t lighttpd-webdav "无法从 lighttpd -p 解析出 server.port，为安全起见不启动 lighttpd（主配置改动保留，排查后手工 /etc/init.d/lighttpd start）。"
	rm -f "$FRAGMENT"
	"$INIT" stop 2>/dev/null
	exit 0
fi

# ---- 5) 端口正确才启用并启动 ----
[ -x "$INIT" ] || exit 0
"$INIT" enable 2>/dev/null
"$INIT" restart 2>/dev/null || "$INIT" start 2>/dev/null

logger -t lighttpd-webdav "WebDAV 已启用: 8080 端口，根目录 $SHARE_DIR（80 保留给 uhttpd/LuCI）"
exit 0
