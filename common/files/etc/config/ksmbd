# SMB 共享预设（ksmbd）—— 由 /etc/init.d/ksmbd 读取，也可在 LuCI「服务 → 网络共享」里改
#
# 设计取向：开箱可用。目录取 /mnt，也就是 block-mount 挂载 U 盘/移动硬盘的位置
# （/mnt/sda1、/mnt/sdb1…）。插上盘就自动能被 Windows/Mac/电视看到，
# 不必为每台设备单独配 WebDAV 客户端。
#
# ⚠️ 默认是「局域网内免密可读写」：
#   guest_ok  yes  —— 没有账号密码，局域网里谁都能连
#   read_only no   —— 可以写
#   对家庭内网是常规做法（很多路由器的「USB 共享」就是这个默认），
#   但如果你家里有访客 WiFi 和主网互通、或端口被映射到公网，必须改：
#     · LuCI「服务 → 网络共享」里加用户、把 guest_ok 关掉
#     · 或把 read_only 改 yes 先只读
#
# 硬刷固件/恢复出厂会重新生成本文件；sysupgrade 保留配置时你自己的改动会留在设备上。

config globals
	option description 'OpenWrt'

config share
	option name 'share'
	option path '/mnt'
	option read_only 'no'
	option guest_ok 'yes'
	option create_mask '0666'
	option dir_mask '0777'
	option force_root '1'
