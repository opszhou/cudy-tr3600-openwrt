# immortalwrt 清单差异修正：在通用清单（lite/ultimate）之后追加，显式关闭或改写上游差异项
#
# 机制：build-device.sh 的必选项审计是致命的（被 defconfig 丢弃的 =y 项直接中止构建），
# 而通用清单里有 kenzok8 源专属的包/子选项，immortalwrt 不加载 kenzok8 feeds，必须显式处理。
# 后写覆盖前写：这里出现的项会覆盖 lite.list / extra.list 里的同名设置。

# ---- TLS 栈去重（避免 openssl/mbedtls 双栈共存）----
# 上游默认包已带 libustream-openssl + apk-openssl，但通用清单的 luci-ssl 集合
# 硬依赖 libustream-mbedtls → 两套 TLS 库共存（约 1~2MB 纯浪费）。
# 换成 luci-ssl-openssl 后只剩一套 openssl 栈（实测 libustream-mbedtls/libmbedtls 消失）
# CONFIG_PACKAGE_luci-ssl is not set
CONFIG_PACKAGE_luci-ssl-openssl=y

# ---- argon 调色面板 ----
# immortalwrt luci 源没有 luci-app-argon-config（themes/applications 路径 404 实查），
# argon 主题本体在（luci-theme-argon ✓），关闭后主题照常可用，只少一个调音面板
# CONFIG_PACKAGE_luci-app-argon-config is not set
# CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn is not set

# ---- turboacc：保留本体，只关 SFE 三件套 ----
# 实测（2026-11-03 容器 defconfig）：SFE 三个模块在 immortalwrt feeds 里不存在，
# 但它们是**条件依赖**（INCLUDE_SHORTCUT_FE* 需要 INCLUDE_OFFLOADING=n 才生效），
# mediatek 上 OFFLOADING 默认 y，所以只要显式关掉这三项，turboacc 本体可正常安装。
# 之前"整个排除 turboacc"的判断是错的（被 Makefile 的无条件 DEPENDS 警告误导），此处纠正。
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_CM is not set
# CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE_DRV is not set

# 全锥 NAT：openwrt main 已删除 kmod-nft-fullcone，通用清单因此关闭该子特性；
# immortalwrt 保留（package/network/utils/fullconenat-nft），这里重新打开——
# 这是「同名包在两个上游存在性不同」的典型例子
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_NFT_FULLCONE=y

# ---- transmission 网页面板 ----
# immortalwrt 的 luci-app-transmission 硬依赖 transmission-web-control（中文增强版 UI），
# 与通用清单里的原版 transmission-web 抢同一个 usr/share/transmission/public_html/index.html，
# 装 rootfs 必炸（run#31 实测）。该上游用 web-control，openwrt 侧保持不变。
# CONFIG_PACKAGE_transmission-web is not set
